{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "评论号码台",
  "version": "0.1.2",
  "identifier": "com.coding.douyin-review-scraper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "评论号码台",
        "width": 1200,
        "height": 800,
        "minWidth": 780,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    },
    "resources": {
      "../scripts/": "scripts/",
      "../node_modules/playwright-core/": "node_modules/playwright-core/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
